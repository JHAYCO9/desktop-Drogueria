<UserControl x:Class="DrogueriaMickey.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                    <TextBlock Text="Panel general" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Command="{Binding LoadSummaryCommand}" Margin="16,0,0,0"
                            Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            Padding="10,6" Cursor="Hand" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,8 A6,6 0 1 1 5,13 M2,8 L2,4 M2,8 L6,8" Stroke="{StaticResource TextMutedBrush}"
                                  StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualizar" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Indicadores de ventas -->
                <TextBlock Text="VENTAS DE HOY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,26">
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="TOTAL VENDIDO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TodaySalesTotal, StringFormat='${0:N0}'}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="N.° DE VENTAS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding TodaySalesCount}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="TICKET PROMEDIO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding AverageTicket, StringFormat='${0:N0}'}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="MÉTODO MÁS USADO" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding MostUsedPaymentMethod}" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Indicadores de inventario -->
                <TextBlock Text="INVENTARIO" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,26">
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="M6,2 L6,6 2,12 10,12 6,6" Stroke="#B8792A" StrokeThickness="1.3"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="STOCK BAJO" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding LowStockCount}" FontSize="22" FontWeight="SemiBold" Foreground="#B8792A"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="AGOTADOS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OutOfStockCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="M6,2 A4,4 0 1 1 6,10 A4,4 0 1 1 6,2 M6,4 L6,6 8,7" Stroke="#B8792A" StrokeThickness="1.3"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="PRÓXIMOS A VENCER" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="22" FontWeight="SemiBold" Foreground="#B8792A"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Path Data="M2,6 L10,6 M6,2 L6,10" Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.4"
                                      StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                                <TextBlock Text="VENCIDOS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ExpiredCount}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Estado de caja -->
                <TextBlock Text="CAJA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                <Border Background="{StaticResource PrimaryGradientBrush}" CornerRadius="6" Padding="20" Margin="0,0,0,26"
                        Cursor="Hand" MouseLeftButtonUp="OnCashCardClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CashStatusLabel, StringFormat='Estado: {0}'}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="{Binding CashBalance, StringFormat='Saldo en efectivo: ${0:N0}'}" FontSize="12.5"
                                       Foreground="#AEC2E8" Margin="0,3,0,0"
                                       Visibility="{Binding CashRegisterOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ver detalle" Foreground="White" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Path Data="M0,0 L5,4 0,8" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="8" Height="8" Stretch="Uniform"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Actividad reciente -->
                <TextBlock Text="ACTIVIDAD RECIENTE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Padding="4">
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="14,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                            Background="{StaticResource BackgroundLightBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Path Data="M5,2 L11,2 11,14 5,14 Z M8,4 L8,4.01" Stroke="{StaticResource PrimaryDarkBrush}" StrokeThickness="1.3"
                                              Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                            <Run Text="{Binding Username, Mode=OneWay}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding CreatedAt, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='${0:N0}'}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                               Visibility="{Binding Amount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>