<UserControl x:Class="DrogueriaMickey.Desktop.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,16,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" VerticalAlignment="Center"/>
                    <Button Content="🔄 Actualizar" Command="{Binding LoadSummaryCommand}" Margin="16,0,0,0"
                            Background="Transparent" BorderBrush="#D1D5DB" BorderThickness="1" Padding="12,6" Cursor="Hand" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- RF-058: indicadores de ventas -->
                <TextBlock Text="VENTAS DE HOY" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="Total vendido" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TodaySalesTotal, StringFormat='${0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="Cantidad de ventas" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TodaySalesCount}" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="Ticket promedio" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding AverageTicket, StringFormat='${0:N0}'}" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="Método más usado" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding MostUsedPaymentMethod}" FontSize="22" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- RF-059: indicadores de inventario, clicables -->
                <TextBlock Text="INVENTARIO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,10"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick">
                        <StackPanel>
                            <TextBlock Text="Stock bajo" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding LowStockCount}" FontSize="22" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick">
                        <StackPanel>
                            <TextBlock Text="Agotados" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding OutOfStockCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick">
                        <StackPanel>
                            <TextBlock Text="Próximos a vencer" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="22" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiCard}" Cursor="Hand" MouseLeftButtonUp="OnAlertCardClick">
                        <StackPanel>
                            <TextBlock Text="Vencidos" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding ExpiredCount}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- RF-057: estado de caja -->
                <TextBlock Text="CAJA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,10"/>
                <Border Background="{StaticResource PrimaryDarkBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,20"
                        Cursor="Hand" MouseLeftButtonUp="OnCashCardClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CashStatusLabel, StringFormat='Estado: {0}'}" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding CashBalance, StringFormat='Saldo en efectivo: ${0:N0}'}" FontSize="13"
                                       Foreground="{StaticResource PrimaryLightBrush}"
                                       Visibility="{Binding CashRegisterOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Ver detalle →" Foreground="White" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- RF-060: actividad reciente -->
                <TextBlock Text="ACTIVIDAD RECIENTE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10"/>
                <Border Background="White" CornerRadius="10" Padding="8">
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="12,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4"
                                            Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                                            <Run Text="{Binding Username, Mode=OneWay}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding CreatedAt, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Amount, StringFormat='${0:N0}'}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding Amount, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>