<UserControl x:Class="DrogueriaMickey.Desktop.Views.CashRegister.CashMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Movimientos de caja" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{StaticResource BackgroundLightBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Text="Desde" FontSize="11"/>
                    <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Text="Hasta" FontSize="11"/>
                    <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                </StackPanel>
                <Button Content="Filtrar" Command="{Binding FilterByDateCommand}"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                        Padding="16,0" VerticalAlignment="Bottom" Height="30" Cursor="Hand"/>
                <Button Content="Ver todo" Command="{Binding LoadAllCommand}" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="1" Padding="12,0" VerticalAlignment="Bottom" Height="30" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo" Binding="{Binding MovementType}" Width="130"/>
                <DataGridTextColumn Header="Monto" Binding="{Binding Amount, StringFormat='${0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="150"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Top" Margin="0,8,0,0"/>
    </Grid>
</UserControl>