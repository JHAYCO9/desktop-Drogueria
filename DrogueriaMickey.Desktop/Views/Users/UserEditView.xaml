<UserControl x:Class="DrogueriaMickey.Desktop.Views.Users.UserEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda: identificación -->
                <Border Grid.Column="0" Background="White" Padding="24" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Identificación" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="NOMBRE COMPLETO" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16" Padding="10,9" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" FontSize="14"/>

                        <TextBlock Text="DOCUMENTO" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                   Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <TextBox Text="{Binding DocumentId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,16" Padding="10,9" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" FontSize="14"
                                 Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="NOMBRE DE USUARIO" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="10,9" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Columna derecha: acceso y permisos -->
                <StackPanel Grid.Column="2">
                    <Border Background="White" Padding="24" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Acceso" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="CONTRASEÑA TEMPORAL" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <PasswordBox x:Name="TempPasswordBox" Margin="0,4,0,16" Padding="10,9" FontSize="14"
                                         Visibility="{Binding IsCreateMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                         PasswordChanged="TempPasswordBox_PasswordChanged"/>

                            <TextBlock Text="ROL" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name"
                                      Margin="0,4,0,0" Padding="9" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="24" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Estado de la cuenta" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <CheckBox Content="Usuario activo" IsChecked="{Binding IsActive}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Button Content="Guardar usuario" Command="{Binding SaveCommand}"
                            Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                            Padding="0,14" FontSize="14.5" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>