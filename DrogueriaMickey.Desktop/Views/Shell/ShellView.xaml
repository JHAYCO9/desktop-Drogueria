<UserControl x:Class="DrogueriaMickey.Desktop.Views.Shell.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource PrimaryDarkBrush}">
            <Grid Margin="20,0">
                <TextBlock Text="Droguería Mickey" Foreground="White" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Username}" Foreground="White" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding RoleName, StringFormat=({0})}" Foreground="{StaticResource PrimaryLightBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="⚠ Sin conexión" Foreground="Orange" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding IsOfflineSession, Converter={StaticResource BoolToVisibilityConverter}}"/>

<Button Content="Cambiar contraseña" Command="{Binding NavigateToChangePasswordCommand}" Padding="8,4" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,8,0"/>

                    <Button Content="Cerrar sesión" Command="{Binding LogoutCommand}" Padding="10,4" Background="Transparent" Foreground="White" BorderThickness="1" BorderBrush="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Menú lateral -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="{StaticResource BackgroundLightBrush}">
            <Button Content="Dashboard" Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="Ventas" Command="{Binding NavigateToSalesCommand}" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="Caja" Command="{Binding NavigateToCashRegisterCommand}" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="Medicamentos" Command="{Binding NavigateToMedicinesCommand}" Style="{StaticResource MenuButtonStyle}"/>
            <Button Content="Usuarios" Command="{Binding NavigateToUsersCommand}" Style="{StaticResource MenuButtonStyle}"
                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
<Button Content="Auditoría" Command="{Binding NavigateToAuditLogCommand}" Style="{StaticResource MenuButtonStyle}"
        Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Contenido -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding Navigation.CurrentView}" Margin="16"/>
    </Grid>
</UserControl>