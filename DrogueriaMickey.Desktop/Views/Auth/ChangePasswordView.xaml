<UserControl x:Class="DrogueriaMickey.Desktop.Views.Auth.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
		<Grid Margin="24">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<TextBlock Text="Cambiar contraseña" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

			<Border Background="White" Padding="24" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"
                    MaxWidth="420" HorizontalAlignment="Left" VerticalAlignment="Top">
				<StackPanel>
					<TextBlock Text="CONTRASEÑA ACTUAL" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
					<PasswordBox x:Name="CurrentBox" Margin="0,4,0,16" Padding="9,8" PasswordChanged="CurrentBox_PasswordChanged"/>

					<TextBlock Text="NUEVA CONTRASEÑA" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
					<PasswordBox x:Name="NewBox" Margin="0,4,0,16" Padding="9,8" PasswordChanged="NewBox_PasswordChanged"/>

					<TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
					<PasswordBox x:Name="ConfirmBox" Margin="0,4,0,16" Padding="9,8" PasswordChanged="ConfirmBox_PasswordChanged"/>

					<TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
					<TextBlock Text="{Binding SuccessMessage}" Foreground="#3D7A4F" TextWrapping="Wrap" Margin="0,0,0,10"/>

					<Button Content="Guardar cambios" Command="{Binding SaveCommand}"
                            Background="{StaticResource PrimaryGradientBrush}" Foreground="White"
                            Padding="0,12" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>