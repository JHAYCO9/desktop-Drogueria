<UserControl x:Class="DrogueriaMickey.Desktop.Views.Auth.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="360">
        <TextBlock Text="Cambiar contrasena" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Contrasena actual"/>
        <PasswordBox x:Name="CurrentBox" Margin="0,4,0,12" Padding="8" PasswordChanged="CurrentBox_PasswordChanged"/>

        <TextBlock Text="Nueva contrasena"/>
        <PasswordBox x:Name="NewBox" Margin="0,4,0,12" Padding="8" PasswordChanged="NewBox_PasswordChanged"/>

        <TextBlock Text="Confirmar nueva contrasena"/>
        <PasswordBox x:Name="ConfirmBox" Margin="0,4,0,12" Padding="8" PasswordChanged="ConfirmBox_PasswordChanged"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <Button Content="Guardar" Command="{Binding SaveCommand}" Background="{StaticResource PrimaryBrush}"
                Foreground="White" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
</UserControl>
