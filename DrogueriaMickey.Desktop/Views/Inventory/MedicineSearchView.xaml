<UserControl x:Class="DrogueriaMickey.Desktop.Views.Inventory.MedicineSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Buscar medicamentos" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{StaticResource BackgroundLightBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="180" Margin="0,0,8,0">
                    <TextBlock Text="Nombre" FontSize="11"/>
                    <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,8,0">
                    <TextBlock Text="Codigo de barras" FontSize="11"/>
                    <TextBox Text="{Binding BarcodeFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                </StackPanel>
                <StackPanel Width="180" Margin="0,0,8,0">
                    <TextBlock Text="Laboratorio" FontSize="11"/>
                    <TextBox Text="{Binding LaboratoryFilter, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                </StackPanel>
                <Button Content="Buscar" Command="{Binding SearchCommand}"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                        Padding="16,0" VerticalAlignment="Bottom" Height="30" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="C digo" Binding="{Binding Barcode}" Width="120"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Laboratorio" Binding="{Binding Laboratory}" Width="*"/>
                <DataGridTextColumn Header="Stock total" Binding="{Binding TotalStock}" Width="90"/>
                <DataGridTextColumn Header="Activo" Binding="{Binding IsActive}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>