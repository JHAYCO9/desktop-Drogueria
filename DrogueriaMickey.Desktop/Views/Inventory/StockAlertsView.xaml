<UserControl x:Class="DrogueriaMickey.Desktop.Views.Inventory.StockAlertsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="AlertSectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Alertas de inventario" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <!-- RF-021 -->
                <Border Style="{StaticResource AlertSectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Medicamentos con stock crítico" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding CriticalMedicines}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding Medicine.Name}" Width="*"/>
                                <DataGridTextColumn Header="STOCK ACTUAL" Binding="{Binding CurrentStock}" Width="100"/>
                                <DataGridTextColumn Header="STOCK MÍNIMO" Binding="{Binding MinStock}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- RF-023 -->
                <Border Style="{StaticResource AlertSectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="M6,2 A4,4 0 1 1 6,10 A4,4 0 1 1 6,2 M6,4 L6,6 8,7" Stroke="#B8792A" StrokeThickness="1.3"
                                  Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Próximos a vencer (30 días)" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding ExpiringSoon}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding MedicineName}" Width="*"/>
                                <DataGridTextColumn Header="LOTE" Binding="{Binding BatchCode}" Width="*"/>
                                <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding ExpirationDate}" Width="120"/>
                                <DataGridTextColumn Header="DÍAS RESTANTES" Binding="{Binding DaysRemaining}" Width="110"/>
                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- RF-024 -->
                <Border Style="{StaticResource AlertSectionCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Path Data="M2,6 L10,6 M6,2 L6,10" Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Vencidos" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Expired}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding MedicineName}" Width="*"/>
                                <DataGridTextColumn Header="LOTE" Binding="{Binding BatchCode}" Width="*"/>
                                <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding ExpirationDate}" Width="120"/>
                                <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- RF-029 -->
                <Border Style="{StaticResource AlertSectionCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Inventario crítico — detalle con motivos" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding CriticalInventory}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="STOCK ACTUAL" Binding="{Binding TotalStock}" Width="90"/>
                                <DataGridTextColumn Header="STOCK MÍNIMO" Binding="{Binding MinStock}" Width="90"/>
                                <DataGridTextColumn Header="MOTIVOS" Binding="{Binding Reasons}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>