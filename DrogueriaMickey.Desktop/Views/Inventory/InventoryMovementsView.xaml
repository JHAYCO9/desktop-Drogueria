<UserControl x:Class="DrogueriaMickey.Desktop.Views.Inventory.InventoryMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <Border Grid.Row="1" Background="White" Padding="14" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,18"
                    Visibility="{Binding ShowDateFilters, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="150" Margin="0,0,10,0">
                        <TextBlock Text="DESDE (AAAA-MM-DD)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="0,0,12,0">
                        <TextBlock Text="HASTA (AAAA-MM-DD)" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>
                    <Button Content="Filtrar" Command="{Binding LoadCommand}"
                            Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                            Padding="16,0" VerticalAlignment="Bottom" Height="32" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding MedicineName}" Width="*"/>
                    <DataGridTextColumn Header="LOTE" Binding="{Binding BatchCode}" Width="140"/>
                    <DataGridTextColumn Header="TIPO" Binding="{Binding MovementType}" Width="100"/>
                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="90"/>
                    <DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" Width="120"/>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding CreatedAt}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>