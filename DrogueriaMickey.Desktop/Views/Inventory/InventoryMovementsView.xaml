<UserControl x:Class="DrogueriaMickey.Desktop.Views.Inventory.InventoryMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <Border Grid.Row="1" Background="{StaticResource BackgroundLightBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,16"
                Visibility="{Binding ShowDateFilters, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Text="Desde (AAAA-MM-DD)" FontSize="11"/>
                    <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                </StackPanel>
                <StackPanel Width="140" Margin="0,0,8,0">
                    <TextBlock Text="Hasta (AAAA-MM-DD)" FontSize="11"/>
                    <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                </StackPanel>
                <Button Content="Filtrar" Command="{Binding LoadCommand}"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                        Padding="16,0" VerticalAlignment="Bottom" Height="30" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Movements}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medicamento" Binding="{Binding MedicineName}" Width="*"/>
                <DataGridTextColumn Header="Lote" Binding="{Binding BatchCode}" Width="140"/>
                <DataGridTextColumn Header="Tipo" Binding="{Binding MovementType}" Width="100"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="120"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>