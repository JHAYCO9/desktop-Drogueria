<UserControl x:Class="DrogueriaMickey.Desktop.Views.Inventory.MedicineEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna izquierda: identificación -->
                <Border Grid.Column="0" Background="White" Padding="20" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Identificación" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <TextBlock Text="CÓDIGO DE BARRAS" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox x:Name="BarcodeBox" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,4,0,14" Padding="9,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" IsEnabled="{Binding IsCreateMode}"/>

                        <TextBlock Text="NOMBRE" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" Padding="9,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>

                        <TextBlock Text="LABORATORIO" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding Laboratory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" Padding="9,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>

                        <TextBlock Text="CONCENTRACIÓN" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding Concentration, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,14" Padding="9,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>

                        <TextBlock Text="PRESENTACIÓN" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding Presentation, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Padding="9,8" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Columna derecha: precios, stock, configuración -->
                <StackPanel Grid.Column="2">
                    <Border Background="White" Padding="20" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Precios" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PASTILLA" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding PricePerPill, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SELLO" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding PricePerSeal, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="CAJA" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding PricePerBox, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Aplica IVA (19%)" IsChecked="{Binding HasIva}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="20" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Formas de venta habilitadas" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <CheckBox Content="Por pastilla suelta" IsChecked="{Binding SellsByPill}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                            <CheckBox Content="Por sello / blíster" IsChecked="{Binding SellsBySeal}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,10" Visibility="{Binding SellsBySeal, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Pastillas por sello" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBox Text="{Binding UnitsPerSeal, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="5" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                            </StackPanel>

                            <CheckBox Content="Por caja / tarro completo" IsChecked="{Binding SellsByBox}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" Visibility="{Binding SellsByBox, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Pastillas por caja" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBox Text="{Binding UnitsPerBox, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="5" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="White" Padding="20" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Stock mínimo" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                            <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Width="150" HorizontalAlignment="Left" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <Button Content="Guardar medicamento" Command="{Binding SaveCommand}"
                            Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                            Padding="0,14" FontSize="14.5" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>