<UserControl x:Class="DrogueriaMickey.Desktop.Views.Inventory.MedicineEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="420">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Código de barras"/>
        <TextBox x:Name="BarcodeBox" Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
         Margin="0,4,0,12" Padding="8" IsEnabled="{Binding IsCreateMode}"/>

        <TextBlock Text="Nombre"/>
        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8"/>

        <TextBlock Text="Laboratorio"/>
        <TextBox Text="{Binding Laboratory, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8"/>

        <TextBlock Text="Concentración"/>
        <TextBox Text="{Binding Concentration, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8"/>

        <TextBlock Text="Presentación"/>
        <TextBox Text="{Binding Presentation, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8"/>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Precio/pastilla"/>
                <TextBox Text="{Binding PricePerPill, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Precio/sello"/>
                <TextBox Text="{Binding PricePerSeal, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Precio/caja"/>
                <TextBox Text="{Binding PricePerBox, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Stock mínimo"/>
        <TextBox Text="{Binding MinStock, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="8"/>

        <CheckBox Content="Aplica IVA (19%)" IsChecked="{Binding HasIva}" Margin="0,0,0,16"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Button Content="Guardar" Command="{Binding SaveCommand}" Background="{StaticResource PrimaryBrush}"
                Foreground="White" Padding="0,10" BorderThickness="0" Cursor="Hand"/>
    </StackPanel>
</UserControl>