<UserControl x:Class="DrogueriaMickey.Desktop.Views.Returns.ReturnsHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Historial de devoluciones" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Returns}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Venta" Binding="{Binding SaleNumber}" Width="80"/>
                <DataGridTextColumn Header="Medicamento" Binding="{Binding MedicineName}" Width="200"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="200"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="150"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>