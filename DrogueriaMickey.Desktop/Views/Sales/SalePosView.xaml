<UserControl x:Class="DrogueriaMickey.Desktop.Views.Sales.SalePosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Punto de venta" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Cancelar venta" Command="{Binding CancelSaleCommand}" Margin="8,0,0,0"
            Background="{StaticResource ErrorBrush}" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand"
            Visibility="{Binding HasActiveSale, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- RF-033: escaneo de productos -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundLightBrush}" Padding="12" CornerRadius="8" Margin="0,0,0,16"
                Visibility="{Binding HasActiveSale, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Código de barras:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="BarcodeBox"
                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                         Width="220" Padding="8" KeyDown="BarcodeBox_KeyDown"/>
                <TextBlock Text="Cantidad:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <TextBox Text="{Binding QuantityInput, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8"/>
                <Button Content="Agregar" Command="{Binding ScanAndAddCommand}" Margin="16,0,0,0"
                        Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Detalle de la venta -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True"
                  Visibility="{Binding HasActiveSale, Converter={StaticResource BoolToVisibilityConverter}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medicamento" Binding="{Binding MedicineName}" Width="*"/>
                <DataGridTextColumn Header="Lote" Binding="{Binding BatchCode}" Width="140"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="Precio unit." Binding="{Binding UnitPrice, StringFormat='${0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="IVA" Binding="{Binding TaxAmount, StringFormat='${0:N0}'}" Width="80"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='${0:N0}'}" Width="100"/>
                <DataGridTemplateColumn Header="" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Quitar"
                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Total y pago -->
        <Border Grid.Row="3" Background="{StaticResource BackgroundLightBrush}" Padding="16" CornerRadius="8" Margin="0,16,0,0"
        Visibility="{Binding HasActiveSale, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{Binding TotalTaxAmount, StringFormat='IVA incluido: ${0:N0}'}" FontSize="12"
                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat='Total: ${0:N0}'}" FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                </StackPanel>
                <Button Content="Cobrar" Command="{Binding OpenPaymentCommand}"
            Background="{StaticResource PrimaryBrush}" Foreground="White" Padding="24,10" BorderThickness="0"
            FontSize="15" Cursor="Hand"/>
            </StackPanel>
        </Border>
        
        <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                   Visibility="{Binding HasActiveSale, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>