<UserControl x:Class="DrogueriaMickey.Desktop.Views.Sales.SaleDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock FontSize="20" FontWeight="Bold">
                <Run Text="Venta #"/><Run Text="{Binding SaleNumber}"/>
            </TextBlock>
            <TextBlock Margin="0,4,0,0">
                <Run Text="Estado: "/><Run Text="{Binding Status}" FontWeight="SemiBold"/>
                <Run Text="   Fecha: "/><Run Text="{Binding CreatedAt}"/>
                <Run Text="   Pago: "/><Run Text="{Binding PaymentMethod}"/>
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Medicamento" Binding="{Binding MedicineName}" Width="200"/>
                <DataGridTextColumn Header="Lote" Binding="{Binding BatchCode}" Width="140"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="Unidad" Binding="{Binding SaleUnit}" Width="90"/>
                <DataGridTextColumn Header="Precio unit." Binding="{Binding UnitPrice, StringFormat='${0:N0}'}" Width="100"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='${0:N0}'}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="{StaticResource BackgroundLightBrush}" Padding="16" CornerRadius="8" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{Binding TotalAmount, StringFormat='Total: ${0:N0}'}" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>

                <!-- RF-046: anular venta, solo si esto finalizada -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding CanVoid, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox Text="{Binding VoidReason, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="8"
                             ToolTip="Motivo de anulaci�n (m�nimo 5 caracteres)"/>
                    <Button Content="Anular venta" Command="{Binding VoidSaleCommand}" Margin="8,0,0,0"
                            Background="{StaticResource ErrorBrush}" Foreground="White" BorderThickness="0"
                            Padding="16,8" Cursor="Hand"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>