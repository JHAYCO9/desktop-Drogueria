<UserControl x:Class="DrogueriaMickey.Desktop.Views.Sales.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Historial de ventas" FontSize="20" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <!-- Filtro por rango -->
            <Border Grid.Row="1" Background="White" Padding="14" CornerRadius="6" BorderThickness="1" BorderBrush="#DADFE3" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="140" Margin="0,0,10,0">
                        <TextBlock Text="FECHA INICIAL" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,0" BorderThickness="1" BorderBrush="#DADFE3"/>
                    </StackPanel>
                    <StackPanel Width="140" Margin="0,0,12,0">
                        <TextBlock Text="FECHA FINAL" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,0" BorderThickness="1" BorderBrush="#DADFE3"/>
                    </StackPanel>
                    <Button Content="Consultar rango" Command="{Binding FilterByRangeCommand}"
                            Foreground="White" BorderThickness="0" Padding="16,0" VerticalAlignment="Bottom" Height="32" Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1B3270" Offset="0"/>
                                <GradientStop Color="#264A8E" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Content="Ver todo" Command="{Binding LoadAllCommand}" Margin="8,0,0,0"
                            Background="Transparent" BorderThickness="1" BorderBrush="#DADFE3"
                            Foreground="{StaticResource TextPrimaryBrush}" Padding="12,0" VerticalAlignment="Bottom" Height="32" Cursor="Hand"/>
                </StackPanel>
            </Border>

            <!-- Resumen del rango -->
            <Border Grid.Row="2" Padding="18" CornerRadius="6" Margin="0,0,0,16"
                    Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1B3270" Offset="0"/>
                        <GradientStop Color="#264A8E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="NÚMERO DE VENTAS" Foreground="#AEC2E8" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SalesCount}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,36,0">
                        <TextBlock Text="TOTAL VENDIDO" Foreground="#AEC2E8" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalSold, StringFormat='${0:N0}'}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="PROMEDIO POR VENTA" Foreground="#AEC2E8" FontSize="10" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding AverageSale, StringFormat='${0:N0}'}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DataGrid Grid.Row="3" ItemsSource="{Binding Sales}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N.° VENTA" Binding="{Binding SaleNumber}" Width="80"/>
                    <DataGridTextColumn Header="ESTADO" Binding="{Binding StatusDisplay}" Width="160"/>
                    <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalAmount, StringFormat='${0:N0}'}" Width="100"/>
                    <DataGridTextColumn Header="MÉTODO DE PAGO" Binding="{Binding PaymentMethod}" Width="120"/>
                    <DataGridTextColumn Header="CAJERO" Binding="{Binding CashierName}" Width="150"/>
                    <DataGridTextColumn Header="FECHA" Binding="{Binding CreatedAt}" Width="180"/>
                    <DataGridTemplateColumn Header="" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Consultar"
                                        Background="Transparent" BorderThickness="1" BorderBrush="#DADFE3"
                                        Foreground="{StaticResource TextPrimaryBrush}" Padding="8,4" Cursor="Hand"
                                        Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Devolver"
                                        Background="Transparent" BorderThickness="1" BorderBrush="#DADFE3"
                                        Foreground="{StaticResource TextPrimaryBrush}" Padding="8,4" Cursor="Hand"
                                        Command="{Binding DataContext.CreateReturnCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="3" Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Top" Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</UserControl>