<UserControl x:Class="DrogueriaMickey.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<UserControl.Resources>
		<Style x:Key="SettingsCard" TargetType="Border">
			<Setter Property="Background" Value="White"/>
			<Setter Property="Padding" Value="20"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
			<Setter Property="Margin" Value="0,0,0,16"/>
		</Style>
		<Style x:Key="SettingsLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="10"/>
			<Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
		</Style>
		<Style x:Key="SettingsInput" TargetType="TextBox">
			<Setter Property="Padding" Value="9,8"/>
			<Setter Property="Margin" Value="0,4,0,14"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
		</Style>
		<Style x:Key="SettingsSaveButton" TargetType="Button">
			<Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="16,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Left"/>
		</Style>
	</UserControl.Resources>

	<Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
		<ScrollViewer VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="24">
				<TextBlock Text="Configuración del sistema" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="20"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- ===================== COLUMNA IZQUIERDA ===================== -->
					<StackPanel Grid.Column="0">

						<!-- RF-079 -->
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Información de la droguería" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
								<TextBlock Text="NOMBRE" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
								<TextBlock Text="NIT" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding BusinessNit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
								<TextBlock Text="DIRECCIÓN" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding BusinessAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="14"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="TELÉFONO" Style="{StaticResource SettingsLabel}"/>
										<TextBox Text="{Binding BusinessPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="CORREO ELECTRÓNICO" Style="{StaticResource SettingsLabel}"/>
										<TextBox Text="{Binding BusinessEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
									</StackPanel>
								</Grid>
								<Button Content="Guardar información" Command="{Binding SaveBusinessInfoCommand}" Style="{StaticResource SettingsSaveButton}"/>
							</StackPanel>
						</Border>

						<!-- RF-086 -->
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Información tributaria" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
								<TextBlock Text="RAZÓN SOCIAL" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
								<TextBlock Text="RÉGIMEN TRIBUTARIO" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding TaxRegime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
								<TextBlock Text="DIRECCIÓN FISCAL" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding FiscalAddress, UpdateSourceTrigger=PropertyChanged}" Padding="9,8" Margin="0,4,0,10" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
								<TextBlock Text="El NIT se toma del campo Información de la droguería, arriba." FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,14"/>
								<Button Content="Guardar información tributaria" Command="{Binding SaveTaxSettingsCommand}" Style="{StaticResource SettingsSaveButton}"/>
							</StackPanel>
						</Border>

						<!-- RF-084 -->
						<Border Style="{StaticResource SettingsCard}" Margin="0">
							<StackPanel>
								<TextBlock Text="Copia de seguridad" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
								<TextBlock Text="{Binding LastBackupAt, StringFormat='Último respaldo: {0}'}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14"/>
								<Button Content="Crear respaldo ahora" Command="{Binding CreateBackupCommand}"
                                        Background="{StaticResource ErrorBrush}" Foreground="White" BorderThickness="0"
                                        Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
							</StackPanel>
						</Border>
					</StackPanel>

					<!-- ===================== COLUMNA DERECHA ===================== -->
					<StackPanel Grid.Column="2">

						<!-- RF-080 -->
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Alertas de vencimiento" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
								<CheckBox Content="Alertas de vencimiento activadas" IsChecked="{Binding ExpirationAlertEnabled}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
								<TextBlock Text="DÍAS DE ANTICIPACIÓN" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding ExpirationAlertDaysInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" Width="100" HorizontalAlignment="Left"/>
								<Button Content="Guardar" Command="{Binding SaveExpirationSettingsCommand}" Style="{StaticResource SettingsSaveButton}"/>
							</StackPanel>
						</Border>

						<!-- RF-081 -->
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Alertas de stock" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
								<CheckBox Content="Alertas de stock activadas" IsChecked="{Binding StockAlertEnabled}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
								<TextBlock Text="FRECUENCIA DE NOTIFICACIÓN (HORAS)" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding StockAlertFrequencyHoursInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" Width="100" HorizontalAlignment="Left"/>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="16"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0">
										<TextBlock Text="HORA INICIO" Style="{StaticResource SettingsLabel}"/>
										<TextBox Text="{Binding StockAlertStartTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" Width="100"/>
									</StackPanel>
									<StackPanel Grid.Column="2">
										<TextBlock Text="HORA FIN" Style="{StaticResource SettingsLabel}"/>
										<TextBox Text="{Binding StockAlertEndTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" Width="100"/>
									</StackPanel>
								</Grid>
								<Button Content="Guardar" Command="{Binding SaveStockSettingsCommand}" Style="{StaticResource SettingsSaveButton}"/>
							</StackPanel>
						</Border>

						<!-- RF-083 -->
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Horario del Reporte Z" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
								<TextBlock Text="HORA DE CIERRE DIARIO" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding ReporteZHour, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}" Width="100" HorizontalAlignment="Left"/>
								<Button Content="Guardar" Command="{Binding SaveReporteZScheduleCommand}" Style="{StaticResource SettingsSaveButton}"/>
							</StackPanel>
						</Border>

						<!-- RF-082 -->
						<Border Style="{StaticResource SettingsCard}">
							<StackPanel>
								<TextBlock Text="Bot de consultas rápidas" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
								<CheckBox Content="Bot habilitado" IsChecked="{Binding BotEnabled}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
								<TextBlock Text="MENSAJE DE BIENVENIDA" Style="{StaticResource SettingsLabel}"/>
								<TextBox Text="{Binding BotWelcomeMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsInput}"/>
								<Button Content="Guardar" Command="{Binding SaveBotConfigCommand}" Style="{StaticResource SettingsSaveButton}"/>
							</StackPanel>
						</Border>
					</StackPanel>
				</Grid>

				<!-- ===================== ANCHO COMPLETO: bot + historial ===================== -->

				<!-- RF-070 -->
				<Border Style="{StaticResource SettingsCard}">
					<StackPanel>
						<TextBlock Text="Usuarios con acceso al bot" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

						<StackPanel Orientation="Horizontal" Margin="0,0,0,14">
							<ComboBox ItemsSource="{Binding AllUsers}" SelectedItem="{Binding SelectedUserToGrant}"
                                      DisplayMemberPath="FullName" Width="260" Padding="8" Margin="0,0,10,0"/>
							<Button Content="Dar acceso" Command="{Binding GrantBotAccessCommand}"
                                    Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0"
                                    Padding="14,8" Cursor="Hand"/>
						</StackPanel>

						<ItemsControl ItemsSource="{Binding BotAuthorizedUsers}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Background="{StaticResource BackgroundLightBrush}" Padding="10,8" CornerRadius="4" Margin="0,0,0,8">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>
											<TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
											<Button Grid.Column="1" Content="Revocar"
                                                    Command="{Binding DataContext.RevokeBotAccessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource ErrorBrush}"
                                                    Foreground="{StaticResource ErrorBrush}" Padding="10,4" Cursor="Hand"/>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
				</Border>

				<!-- RF-078 -->
				<Border Style="{StaticResource SettingsCard}" Margin="0">
					<StackPanel>
						<TextBlock Text="Historial de consultas del bot" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>
						<DataGrid ItemsSource="{Binding BotQueryLogs}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
							<DataGrid.Columns>
								<DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" Width="130"/>
								<DataGridTextColumn Header="COMANDO" Binding="{Binding Command}" Width="180"/>
								<DataGridTextColumn Header="RESULTADO" Binding="{Binding Result}" Width="*"/>
								<DataGridTextColumn Header="FECHA" Binding="{Binding CreatedAt}" Width="150"/>
							</DataGrid.Columns>
						</DataGrid>
					</StackPanel>
				</Border>

				<TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
				<TextBlock Text="{Binding SuccessMessage}" Foreground="#3D7A4F" TextWrapping="Wrap" Margin="0,8,0,0"/>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>