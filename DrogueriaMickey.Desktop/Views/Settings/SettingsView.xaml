<UserControl x:Class="DrogueriaMickey.Desktop.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24" MaxWidth="700">
                <TextBlock Text="Configuración del sistema" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}" Margin="0,0,0,20"/>

                <!-- RF-079 -->
                <Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Información de la droguería" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
                        <TextBlock Text="Nombre" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding BusinessName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,12"/>
                        <TextBlock Text="NIT" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding BusinessNit, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,12"/>
                        <TextBlock Text="Dirección" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding BusinessAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Width="200" Margin="0,0,16,0">
                                <TextBlock Text="Teléfono" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding BusinessPhone, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,12"/>
                            </StackPanel>
                            <StackPanel Width="300">
                                <TextBlock Text="Correo electrónico" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding BusinessEmail, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,12"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="Guardar información" Command="{Binding SaveBusinessInfoCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                                Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- RF-086 -->
<Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
    <StackPanel>
        <TextBlock Text="Información tributaria" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
        <TextBlock Text="Razón social" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox Text="{Binding LegalName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,12"/>
        <TextBlock Text="Régimen tributario" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox Text="{Binding TaxRegime, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,12"/>
        <TextBlock Text="Dirección fiscal" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox Text="{Binding FiscalAddress, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,14"/>
        <TextBlock Text="Nota: el NIT se toma del campo de 'Información de la droguería' de arriba." FontSize="11"
                   Foreground="{StaticResource TextMutedBrush}" FontStyle="Italic" Margin="0,0,0,14"/>
        <Button Content="Guardar información tributaria" Command="{Binding SaveTaxSettingsCommand}"
                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
    </StackPanel>
</Border>

                <!-- RF-080 -->
                <Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Alertas de vencimiento" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
                        <CheckBox Content="Alertas de vencimiento activadas" IsChecked="{Binding ExpirationAlertEnabled}" Margin="0,0,0,12"/>
                        <TextBlock Text="Días de anticipación" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ExpirationAlertDaysInput, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="100" HorizontalAlignment="Left" Margin="0,4,0,14"/>
                        <Button Content="Guardar" Command="{Binding SaveExpirationSettingsCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                                Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- RF-081 -->
                <Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Alertas de stock" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
                        <CheckBox Content="Alertas de stock activadas" IsChecked="{Binding StockAlertEnabled}" Margin="0,0,0,12"/>
                        <TextBlock Text="Frecuencia de notificación (horas)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding StockAlertFrequencyHoursInput, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="100" HorizontalAlignment="Left" Margin="0,4,0,12"/>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Hora inicio" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding StockAlertStartTime, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="100" Margin="0,4,0,14"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Hora fin" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding StockAlertEndTime, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="100" Margin="0,4,0,14"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Content="Guardar" Command="{Binding SaveStockSettingsCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                                Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- RF-083 -->
                <Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Horario del Reporte Z" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
                        <TextBlock Text="Hora de cierre diario" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBox Text="{Binding ReporteZHour, UpdateSourceTrigger=PropertyChanged}" Padding="8" Width="100" HorizontalAlignment="Left" Margin="0,4,0,14"/>
                        <Button Content="Guardar" Command="{Binding SaveReporteZScheduleCommand}"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                                Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- RF-082 -->
<Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
    <StackPanel>
        <TextBlock Text="Bot de consultas rápidas" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
        <CheckBox Content="Bot habilitado" IsChecked="{Binding BotEnabled}" Margin="0,0,0,12"/>
        <TextBlock Text="Mensaje de bienvenida" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
        <TextBox Text="{Binding BotWelcomeMessage, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,4,0,14"/>
        <Button Content="Guardar" Command="{Binding SaveBotConfigCommand}"
                Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
    </StackPanel>
</Border>

<!-- RF-070 -->
<Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
    <StackPanel>
        <TextBlock Text="Usuarios con acceso al bot" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <ComboBox ItemsSource="{Binding AllUsers}" SelectedItem="{Binding SelectedUserToGrant}"
                      DisplayMemberPath="FullName" Width="250" Padding="8" Margin="0,0,8,0"/>
            <Button Content="Dar acceso" Command="{Binding GrantBotAccessCommand}"
                    Background="{StaticResource PrimaryBrush}" Foreground="White" BorderThickness="0"
                    Padding="14,8" Cursor="Hand"/>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding BotAuthorizedUsers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource BackgroundLightBrush}" Padding="10" CornerRadius="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FullName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Content="Revocar"
                                    Command="{Binding DataContext.RevokeBotAccessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Background="{StaticResource ErrorBrush}" Foreground="White" BorderThickness="0" Padding="10,4" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</Border>

<!-- RF-078 -->
<Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
    <StackPanel>
        <TextBlock Text="Historial de consultas del bot" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,14"/>
        <DataGrid ItemsSource="{Binding BotQueryLogs}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="130"/>
                <DataGridTextColumn Header="Comando" Binding="{Binding Command}" Width="180"/>
                <DataGridTextColumn Header="Resultado" Binding="{Binding Result}" Width="*"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding CreatedAt}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</Border>

                <!-- RF-084 -->
                <Border Background="White" Padding="20" CornerRadius="10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Copia de seguridad" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding LastBackupAt, StringFormat='último respaldo: {0}'}" FontSize="13" Margin="0,0,0,14"/>
                        <Button Content="Crear respaldo ahora" Command="{Binding CreateBackupCommand}"
                                Background="{StaticResource ErrorBrush}" Foreground="White" BorderThickness="0"
                                Padding="16,8" Cursor="Hand" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="Green" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>