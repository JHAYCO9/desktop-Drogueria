<UserControl x:Class="DrogueriaMickey.Desktop.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ExportPdfButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundLightBrush}" Margin="-16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <TextBlock Text="Reportes" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20"/>

                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- RF-061 -->
                    <TabItem Header="Ventas diarias">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBox Text="{Binding DailyDate, UpdateSourceTrigger=PropertyChanged}" Width="140" Padding="8" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                <Button Content="Generar" Command="{Binding GenerateDailyReportCommand}"
                                        Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,8,0"/>
                                <Button Content="Imprimir" Command="{Binding PrintDailyReportCommand}" Style="{StaticResource ExportPdfButton}"/>
                            </StackPanel>
                            <Border Background="White" Padding="18" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" MaxWidth="400"
                                    Visibility="{Binding DailyReport, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DailyReport.Date, StringFormat='Fecha: {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DailyReport.SalesCount, StringFormat='N.° de ventas: {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DailyReport.TotalSold, StringFormat='Total vendido: ${0:N0}'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DailyReport.TotalEfectivo, StringFormat='Total efectivo: ${0:N0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DailyReport.TotalNequi, StringFormat='Total Nequi: ${0:N0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding DailyReport.AverageTicket, StringFormat='Ticket promedio: ${0:N0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Exportar PDF" Command="{Binding ExportDailyPdfCommand}" Style="{StaticResource ExportPdfButton}" Margin="0,0,8,0"/>
                                        <Button Content="Exportar Excel" Command="{Binding ExportDailyExcelCommand}" Style="{StaticResource ExportPdfButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- RF-062 -->
                    <TabItem Header="Ventas mensuales">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBox Text="{Binding MonthlyYear, UpdateSourceTrigger=PropertyChanged}" Width="80" Padding="8" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                <TextBox Text="{Binding MonthlyMonth, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                <Button Content="Generar" Command="{Binding GenerateMonthlyReportCommand}"
                                        Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand"/>
                            </StackPanel>
                            <Border Background="White" Padding="18" CornerRadius="6" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}" MaxWidth="400"
                                    Visibility="{Binding MonthlyReport, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding MonthlyReport.Month, StringFormat='Mes: {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding MonthlyReport.SalesCount, StringFormat='N.° de ventas: {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding MonthlyReport.TotalSold, StringFormat='Total vendido: ${0:N0}'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding MonthlyReport.AverageDaily, StringFormat='Promedio diario: ${0:N0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding MonthlyReport.BestDay, StringFormat='Mejor día: {0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding MonthlyReport.BestDayTotal, StringFormat='Total ese día: ${0:N0}'}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Exportar PDF" Command="{Binding ExportMonthlyPdfCommand}" Style="{StaticResource ExportPdfButton}" Margin="0,0,8,0"/>
                                        <Button Content="Exportar Excel" Command="{Binding ExportMonthlyExcelCommand}" Style="{StaticResource ExportPdfButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- RF-063 -->
                    <TabItem Header="Más vendidos">
                        <StackPanel Margin="0,16,0,0">
                            <Button Content="Generar reporte" Command="{Binding GenerateTopProductsReportCommand}"
                                    Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand"
                                    HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <DataGrid ItemsSource="{Binding TopProductsReport}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding Name}" Width="250"/>
                                    <DataGridTextColumn Header="CANTIDAD VENDIDA" Binding="{Binding QuantitySold}" Width="140"/>
                                    <DataGridTextColumn Header="TOTAL GENERADO" Binding="{Binding TotalGenerated, StringFormat='${0:N0}'}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- RF-064 -->
                    <TabItem Header="Menor rotación">
                        <StackPanel Margin="0,16,0,0">
                            <Button Content="Generar reporte" Command="{Binding GenerateLowRotationReportCommand}"
                                    Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand"
                                    HorizontalAlignment="Left" Margin="0,0,0,16"/>
                            <DataGrid ItemsSource="{Binding LowRotationReport}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding Name}" Width="250"/>
                                    <DataGridTextColumn Header="CANTIDAD VENDIDA" Binding="{Binding QuantitySold}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- RF-065 -->
                    <TabItem Header="Inventario">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="Generar reporte" Command="{Binding GenerateInventoryReportCommand}"
                                        Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,16,0"/>
                                <Button Content="PDF" Command="{Binding ExportInventoryPdfCommand}" Style="{StaticResource ExportPdfButton}" Margin="0,0,8,0"/>
                                <Button Content="Excel" Command="{Binding ExportInventoryExcelCommand}" Style="{StaticResource ExportPdfButton}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding InventoryReport}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="STOCK ACTUAL" Binding="{Binding TotalStock}" Width="100"/>
                                    <DataGridTextColumn Header="STOCK MÍNIMO" Binding="{Binding MinStock}" Width="100"/>
                                    <DataGridTextColumn Header="LOTES" Binding="{Binding AvailableBatches}" Width="70"/>
                                    <DataGridTextColumn Header="PRÓX. VENCIM." Binding="{Binding NextExpiration}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- RF-066 -->
                    <TabItem Header="Próximos a vencer">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBlock Text="Días:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBox Text="{Binding ExpiringDays, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="8" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                <Button Content="Generar" Command="{Binding GenerateExpiringReportCommand}"
                                        Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,16,0"/>
                                <Button Content="PDF" Command="{Binding ExportExpiringPdfCommand}" Style="{StaticResource ExportPdfButton}" Margin="0,0,8,0"/>
                                <Button Content="Excel" Command="{Binding ExportExpiringExcelCommand}" Style="{StaticResource ExportPdfButton}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding ExpiringReport}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding MedicineName}" Width="200"/>
                                    <DataGridTextColumn Header="LOTE" Binding="{Binding BatchCode}" Width="140"/>
                                    <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding ExpirationDate}" Width="120"/>
                                    <DataGridTextColumn Header="DÍAS RESTANTES" Binding="{Binding DaysRemaining}" Width="110"/>
                                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- RF-067 -->
                    <TabItem Header="Vencidos">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="Generar reporte" Command="{Binding GenerateExpiredReportCommand}"
                                        Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,16,0"/>
                                <Button Content="PDF" Command="{Binding ExportExpiredPdfCommand}" Style="{StaticResource ExportPdfButton}" Margin="0,0,8,0"/>
                                <Button Content="Excel" Command="{Binding ExportExpiredExcelCommand}" Style="{StaticResource ExportPdfButton}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding ExpiredReport}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding MedicineName}" Width="200"/>
                                    <DataGridTextColumn Header="LOTE" Binding="{Binding BatchCode}" Width="140"/>
                                    <DataGridTextColumn Header="VENCIMIENTO" Binding="{Binding ExpirationDate}" Width="120"/>
                                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>

                    <!-- RF-068 -->
                    <TabItem Header="Movimientos">
                        <StackPanel Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <TextBox Text="{Binding MovementsFrom, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="8" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                <TextBox Text="{Binding MovementsTo, UpdateSourceTrigger=PropertyChanged}" Width="130" Padding="8" Margin="0,0,8,0" BorderThickness="1" BorderBrush="{StaticResource BorderBrush}"/>
                                <Button Content="Generar" Command="{Binding GenerateMovementsReportCommand}"
                                        Background="{StaticResource PrimaryGradientBrush}" Foreground="White" BorderThickness="0" Padding="14,8" Cursor="Hand" Margin="0,0,16,0"/>
                                <Button Content="PDF" Command="{Binding ExportMovementsPdfCommand}" Style="{StaticResource ExportPdfButton}" Margin="0,0,8,0"/>
                                <Button Content="Excel" Command="{Binding ExportMovementsExcelCommand}" Style="{StaticResource ExportPdfButton}"/>
                            </StackPanel>
                            <DataGrid ItemsSource="{Binding MovementsReport}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="MEDICAMENTO" Binding="{Binding MedicineName}" Width="180"/>
                                    <DataGridTextColumn Header="LOTE" Binding="{Binding BatchCode}" Width="130"/>
                                    <DataGridTextColumn Header="TIPO" Binding="{Binding MovementType}" Width="100"/>
                                    <DataGridTextColumn Header="CANTIDAD" Binding="{Binding Quantity}" Width="90"/>
                                    <DataGridTextColumn Header="USUARIO" Binding="{Binding Username}" Width="130"/>
                                    <DataGridTextColumn Header="FECHA" Binding="{Binding CreatedAt}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                <TextBlock Text="{Binding SuccessMessage}" Foreground="#3D7A4F" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>