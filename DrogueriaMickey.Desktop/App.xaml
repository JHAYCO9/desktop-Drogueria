<Application x:Class="DrogueriaMickey.Desktop.App"
             xmlns:conv="clr-namespace:DrogueriaMickey.Desktop.Converters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DrogueriaMickey.Desktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="DataGrid">
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="CanUserResizeColumns" Value="True"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
                <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            </Style>

            <SolidColorBrush x:Key="PrimaryBrush" Color="#3B82F6"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#60A5FA"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#1E3A8A"/>
            <SolidColorBrush x:Key="BackgroundLightBrush" Color="#EFF6FF"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <conv:ActiveToLabelConverter x:Key="ActiveToLabelConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>